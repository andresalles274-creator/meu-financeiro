<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_bg">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MEU FINANCEIRO" android:textColor="#35F56A" android:textStyle="bold" android:textSize="13sp"/>
<TextView android:id="@+id/wBalance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="R$ 0,00" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="30sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal"><TextView android:id="@+id/wIn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Entrou hoje\nR$ 0,00" android:textColor="#35F56A" android:textSize="13sp"/><TextView android:id="@+id/wOut" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="Saiu hoje\nR$ 0,00" android:textColor="#FF5362" android:textSize="13sp"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal"><Button android:id="@+id/wAddIn" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="+ Entrada"/><Button android:id="@+id/wAddOut" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="− Saída"/></LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="ÚLTIMOS LANÇAMENTOS" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp"/>
<TextView android:id="@+id/wRecent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="4" android:text="Abra o app para sincronizar" android:textColor="#B7C0BA" android:textSize="12sp"/>
</LinearLayout>